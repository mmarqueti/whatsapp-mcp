# Meta WhatsApp Cloud API credentials (Meta App Dashboard)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_WABA_ID=

# Token you choose; must match the verify token configured in the
# Meta App Dashboard webhook settings.
META_VERIFY_TOKEN=

# App Secret of the Meta app (App Dashboard -> Settings -> Basic).
# Required: POST /webhook validates the X-Hub-Signature-256 header of
# every delivery against it and the server refuses to start without it.
META_APP_SECRET=

# Shared secret that authenticates MCP WebSocket clients.
# Required for WebSocket mode (the server refuses to start without it);
# optional only when running with --stdio.
MCP_AUTH_TOKEN=

# Port of the HTTP server (webhook + health). MCP WebSocket clients
# connect on this same port.
PORT=4000

# Optional
LOG_LEVEL=info
